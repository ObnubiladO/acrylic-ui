<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The colours of the dark appearance. Themes\Light.xaml defines the very same keys for the light one: every key
        added here must be added there too. Nothing else in the application names a colour directly.
    -->

    <!-- Surfaces -->

    <SolidColorBrush x:Key="WindowBrush" Color="#15171C" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E2127" />
    <SolidColorBrush x:Key="PanelBrush" Color="#23272E" />
    <SolidColorBrush x:Key="InputBrush" Color="#14161A" />
    <SolidColorBrush x:Key="MenuBrush" Color="#272B33" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A015171C" />

    <!-- Lines -->

    <SolidColorBrush x:Key="LineBrush" Color="#343941" />
    <SolidColorBrush x:Key="ControlLineBrush" Color="#4A515B" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2B3037" />

    <!-- States of neutral elements -->

    <SolidColorBrush x:Key="HoverBrush" Color="#2C313A" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#252A31" />
    <SolidColorBrush x:Key="GraySoftBrush" Color="#30353E" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#59616C" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4B525C" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#69727E" />

    <!-- Text -->

    <SolidColorBrush x:Key="TextBrush" Color="#E7E9EC" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#A7AFB9" />
    <SolidColorBrush x:Key="FaintBrush" Color="#7C8590" />

    <!-- Accent: the Brush is for fills, the TextBrush for text written in the accent colour -->

    <SolidColorBrush x:Key="AccentBrush" Color="#3B7BF0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#5590F5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#2F68D4" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#7DB0FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E3257" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#2E4C82" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Tones: the Brush is for text and signs, the SoftBrush for the background behind them -->

    <SolidColorBrush x:Key="GreenBrush" Color="#5ED37A" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#173322" />
    <SolidColorBrush x:Key="RedBrush" Color="#FF8078" />
    <SolidColorBrush x:Key="RedSoftBrush" Color="#3F1E20" />
    <SolidColorBrush x:Key="AmberBrush" Color="#E8BD52" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="#3A2F12" />
    <SolidColorBrush x:Key="AmberLineBrush" Color="#5F4D1C" />

    <!-- What the built-in control templates paint the corner between two scroll bars with. -->

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#1E2127" />

</ResourceDictionary>
