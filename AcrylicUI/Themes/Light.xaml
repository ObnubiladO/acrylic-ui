<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The colours of the light appearance. Themes\Dark.xaml defines the very same keys for the dark one: every key
        added here must be added there too. Nothing else in the application names a colour directly.
    -->

    <!-- Surfaces -->

    <SolidColorBrush x:Key="WindowBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F8FA" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#66F3F5F8" />

    <!-- Lines -->

    <SolidColorBrush x:Key="LineBrush" Color="#DFE3E8" />
    <SolidColorBrush x:Key="ControlLineBrush" Color="#C9D0D8" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#EEF0F3" />

    <!-- States of neutral elements -->

    <SolidColorBrush x:Key="HoverBrush" Color="#EEF1F5" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="GraySoftBrush" Color="#E9ECF0" />
    <SolidColorBrush x:Key="SwitchOffBrush" Color="#B8C0CA" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4CAD2" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA3AE" />

    <!-- Text -->

    <SolidColorBrush x:Key="TextBrush" Color="#1B1F24" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#57606A" />
    <SolidColorBrush x:Key="FaintBrush" Color="#8B949E" />

    <!-- Accent: the Brush is for fills, the TextBrush for text written in the accent colour -->

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4FD8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1A44BC" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4FD8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E6EEFD" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#C4D5F9" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- Tones: the Brush is for text and signs, the SoftBrush for the background behind them -->

    <SolidColorBrush x:Key="GreenBrush" Color="#1A7F37" />
    <SolidColorBrush x:Key="GreenSoftBrush" Color="#DDF4E4" />
    <SolidColorBrush x:Key="RedBrush" Color="#C62828" />
    <SolidColorBrush x:Key="RedSoftBrush" Color="#FDEBEA" />
    <SolidColorBrush x:Key="AmberBrush" Color="#8A5A00" />
    <SolidColorBrush x:Key="AmberSoftBrush" Color="#FFF3D1" />
    <SolidColorBrush x:Key="AmberLineBrush" Color="#F0D58A" />

    <!-- What the built-in control templates paint the corner between two scroll bars with. -->

    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />

</ResourceDictionary>
