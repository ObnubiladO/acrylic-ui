<Window x:Class="AcrylicUI.Views.PatternTesterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:AcrylicUI"
        Title="RegEx tester" Width="560" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="20,16,20,18">

        <TextBlock x:Name="IntroText" Style="{StaticResource Subtle}" TextTrimming="None" Margin="0,0,0,14" />

        <TextBlock Text="Domain name" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBox x:Name="DomainBox" ui:Look.Placeholder="www.google.com" TextChanged="Input_TextChanged" />

        <TextBlock x:Name="PatternLabel" FontWeight="SemiBold" Margin="0,14,0,5" />
        <TextBox x:Name="PatternBox" FontFamily="{StaticResource MonoFont}" TextChanged="Input_TextChanged" />

        <Border x:Name="ResultPanel" CornerRadius="6" Padding="12,9" Margin="0,16,0,0" Background="{DynamicResource GraySoftBrush}">
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" TextTrimming="None" FontWeight="SemiBold" />
        </Border>

        <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right" MinWidth="88" Margin="0,18,0,0" />

    </StackPanel>
</Window>
