<UserControl x:Class="AcrylicUI.Views.HostsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AcrylicUI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->

        <DockPanel Grid.Row="0" Margin="16,12,16,10" LastChildFill="False">
            <Grid DockPanel.Dock="Left" Width="320">
                <TextBox x:Name="SearchBox" Padding="30,0,7,0" ui:Look.Placeholder="Filter the entries (Ctrl+F)" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Filter the entries" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left" />
            </Grid>

            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save" ui:Look.Glyph="&#xE74E;" Click="Save_Click" Margin="6,0,0,0" MinWidth="88" ToolTip="Saves AcrylicHosts.txt (Ctrl+S)" />
            <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="Discard changes" Click="Discard_Click" Margin="6,0,0,0" ToolTip="Forgets every change made since the last save and reads the file again" />
            <ToggleButton x:Name="TextModeButton" DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" Content="Edit as text" ui:Look.Glyph="&#xE8A5;" Checked="TextMode_Changed" Unchecked="TextMode_Changed" Margin="6,0,10,0" ToolTip="Shows the whole file, comments included, in a plain text editor. Ctrl + mouse wheel changes the size of its text." />
            <Border x:Name="UnsavedChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource AmberSoftBrush}" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="What you changed is not in the file yet: press Save (Ctrl+S)">
                <TextBlock Text="Not saved yet" Foreground="{DynamicResource AmberBrush}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Border x:Name="NoticePanel" Grid.Row="1" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,5,6,5" Margin="16,0,16,10" Visibility="Collapsed">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="NoticeText" DockPanel.Dock="Left" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="None" />
                <ToggleButton x:Name="ProblemsOnlyButton" DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" Content="Show only these" Checked="ProblemsOnly_Changed" Unchecked="ProblemsOnly_Changed" MinHeight="26" />
            </DockPanel>
        </Border>

        <!-- Structured editor -->

        <Grid x:Name="StructuredPanel" Grid.Row="2" Margin="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- What would Acrylic do with a domain name? -->

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,9" Margin="0,0,0,10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="Try a domain name" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Tells which entry of the hosts file, if any, decides the answer for a domain name. It considers what you see here, saved or not." />
                    <TextBox x:Name="TryBox" DockPanel.Dock="Left" Width="250" ui:Look.Placeholder="www.example.com" TextChanged="TryBox_TextChanged" AutomationProperties.Name="Try a domain name" />
                    <Button x:Name="TryShowButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show the entry" Click="TryShow_Click" Margin="12,0,2,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TryResult" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" TextTrimming="None" Text="Type a domain name to see what the hosts file does with it." />
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="8,7">
                        <DockPanel LastChildFill="False">
                            <Button x:Name="AddButton" DockPanel.Dock="Left" Content="Add an entry" ui:Look.Glyph="&#xE710;" Click="Add_Click" ToolTip="Adds an entry after the selected one, or at the end of the file (Ins)" />
                            <Button x:Name="EditButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Edit" ui:Look.Glyph="&#xE70F;" Click="Edit_Click" Margin="8,0,0,0" ToolTip="Edits the selected line (Enter, or double click)" />
                            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Delete" ui:Look.Glyph="&#xE74D;" Click="Delete_Click" ToolTip="Deletes the selected lines (Del)" />
                            <Button x:Name="SwitchButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Switch on / off" ui:Look.Glyph="&#xE7E8;" Click="Toggle_Click" ToolTip="Switches the selected entries off, by putting a # right in front of them, or on again (Space)" />
                            <Button x:Name="MoveUpButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" ui:Look.Glyph="&#xE74A;" Click="MoveUp_Click" ToolTip="Moves the selected line up. Among patterns and among regular expressions, the first one that matches wins." AutomationProperties.Name="Move up" />
                            <Button x:Name="MoveDownButton" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" ui:Look.Glyph="&#xE74B;" Click="MoveDown_Click" ToolTip="Moves the selected line down" AutomationProperties.Name="Move down" />
                            <CheckBox x:Name="ShowCommentsBox" DockPanel.Dock="Right" Content="Show comments and blank lines" VerticalAlignment="Center" Margin="0,0,8,0" Checked="ShowComments_Changed" Unchecked="ShowComments_Changed" />
                        </DockPanel>
                    </Border>

                    <ListView x:Name="EntryList" Grid.Row="1" Style="{StaticResource Table}" SelectionMode="Extended" SelectionChanged="EntryList_SelectionChanged" MouseDoubleClick="EntryList_MouseDoubleClick" PreviewKeyDown="EntryList_PreviewKeyDown" AutomationProperties.Name="Hosts entries">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource TableHeader}" AllowsColumnReorder="False">
                                <GridViewColumn Header="On" Width="44">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0" Visibility="{Binding IsEntry, Converter={StaticResource BoolToVisibility}}" ToolTip="Switched on: Acrylic uses this entry" AutomationProperties.Name="Switched on" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Action" Width="104">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Opacity="{Binding TextOpacity}">
                                                <Border Style="{StaticResource ToneChip}" Visibility="{Binding ActionText, Converter={StaticResource TextToVisibility}}">
                                                    <TextBlock Text="{Binding ActionText}" Style="{StaticResource ToneText}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Address or file" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TargetText}" FontFamily="{StaticResource MonoFont}" Opacity="{Binding TextOpacity}" ToolTip="{Binding TargetText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Domain names" Width="400">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource AmberBrush}" Margin="0,0,7,0" ToolTip="{Binding Problem}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock x:Name="HostsText" Text="{Binding HostsText}" FontFamily="{StaticResource MonoFont}" Opacity="{Binding TextOpacity}" ToolTip="{Binding HostsToolTip}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsComment}" Value="True">
                                                    <Setter TargetName="HostsText" Property="FontStyle" Value="Italic" />
                                                    <Setter TargetName="HostsText" Property="FontFamily" Value="Segoe UI" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Comment" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CommentText}" Foreground="{DynamicResource SubtleBrush}" Opacity="{Binding TextOpacity}" ToolTip="{Binding CommentText}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Line" Width="56">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LineNumber}" Foreground="{DynamicResource FaintBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="EmptyText" Grid.Row="1" Style="{StaticResource Subtle}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="40,40,40,0" Visibility="Collapsed" />

                    <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,6" Background="{DynamicResource PanelBrush}">
                        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource SubtleBrush}" FontSize="12" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Plain text editor -->

        <Border x:Name="TextPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="16,0,16,12" Visibility="Collapsed" ClipToBounds="True">
            <TextBox x:Name="TextEditor" Style="{StaticResource CodeEditor}" TextChanged="TextEditor_TextChanged" AutomationProperties.Name="Hosts file text" />
        </Border>

    </Grid>
</UserControl>
