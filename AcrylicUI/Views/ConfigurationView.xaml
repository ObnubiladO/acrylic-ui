<UserControl x:Class="AcrylicUI.Views.ConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:AcrylicUI">

    <UserControl.Resources>

        <Style x:Key="RowContainer" TargetType="ContentPresenter">
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}" />
        </Style>

        <!-- One parameter: what it is on the left, its editor on the right (or below, for the long ones). -->

        <DataTemplate x:Key="SettingRowTemplate">
            <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="16,11,10,12" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="{Binding Context}" FontSize="11" Foreground="{DynamicResource FaintBrush}" Margin="0,0,0,2" Visibility="{Binding Context, Converter={StaticResource TextToVisibility}}" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,1,7,0" VerticalAlignment="Center" ToolTip="{Binding ModifiedToolTip}" Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Subtle}" FontSize="12" TextTrimming="None" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding Key}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource FaintBrush}" Margin="0,4,0,0" ToolTip="The name of this parameter in AcrylicConfiguration.ini" />
                    </StackPanel>

                    <StackPanel x:Name="EditorPanel" Grid.Column="1" Width="292" VerticalAlignment="Top">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ui:Look.Glyph="&#xE7A7;" Padding="7,0" Margin="4,0,0,0" ToolTip="{Binding ResetToolTip}" Click="Reset_Click" Visibility="{Binding CanReset, Converter={StaticResource BoolToHidden}}" AutomationProperties.Name="Reset to default" VerticalAlignment="Top" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Unit}" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="74" Visibility="{Binding Unit, Converter={StaticResource TextToVisibility}}" />
                            <Grid>
                                <TextBox x:Name="ValueBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ui:Look.HasError="{Binding HasError}" ui:Look.Placeholder="{Binding Placeholder}" Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Key}" />
                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BoolValue}" HorizontalAlignment="Left" Margin="0,5" Visibility="{Binding IsYesNo, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Key}" />
                                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding ChoiceValue}" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Key}" />
                                <ItemsControl ItemsSource="{Binding HitLogFlags}" Visibility="{Binding IsHitLog, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Label}" Margin="0,3,16,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="{DynamicResource FaintBrush}" Margin="2,3,0,0" Visibility="{Binding Hint, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Text="{Binding Error}" FontSize="12" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" TextTrimming="None" Margin="2,4,0,0" Visibility="{Binding Error, Converter={StaticResource TextToVisibility}}" />
                        <Button Style="{StaticResource LinkButton}" Content="Test this mask against a domain name..." FontSize="12" HorizontalAlignment="Left" Margin="2,5,0,0" Click="TestMask_Click" Visibility="{Binding IsDomainNameMask, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWide}" Value="True">
                    <Setter TargetName="EditorPanel" Property="Grid.Column" Value="0" />
                    <Setter TargetName="EditorPanel" Property="Grid.Row" Value="1" />
                    <Setter TargetName="EditorPanel" Property="Grid.ColumnSpan" Value="2" />
                    <Setter TargetName="EditorPanel" Property="Width" Value="Auto" />
                    <Setter TargetName="EditorPanel" Property="Margin" Value="0,8,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding UsesMonoFont}" Value="True">
                    <Setter TargetName="ValueBox" Property="FontFamily" Value="{StaticResource MonoFont}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="ServerCardTemplate">
            <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Visibility="{Binding MatchesSearch, Converter={StaticResource BoolToVisibility}}">
                <Expander.Header>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource ToneChip}">
                            <TextBlock Text="{Binding ChipText}" Style="{StaticResource ToneText}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="SemiBold" Width="150" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </Expander.Header>
                <StackPanel>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Use a public DNS service" ui:Look.Glyph="&#xE774;" Click="Preset_Click" ToolTip="Fills in the address, the port and the protocol of a well known public DNS service" />
                            <Button Content="Don't use this server" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="ClearServer_Click" ToolTip="Empties the address: a server without address is not used" />
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource SettingRowTemplate}" ItemContainerStyle="{StaticResource RowContainer}" Focusable="False" />
                </StackPanel>
            </Expander>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->

        <DockPanel Grid.Row="0" Margin="16,12,16,10" LastChildFill="False">
            <Grid DockPanel.Dock="Left" Width="320">
                <TextBox x:Name="SearchBox" Padding="30,0,7,0" ui:Look.Placeholder="Search the parameters (Ctrl+F)" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="Search the parameters" />
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource FaintBrush}" Margin="10,0,0,0" IsHitTestVisible="False" HorizontalAlignment="Left" />
            </Grid>
            <TextBlock x:Name="SearchSummary" DockPanel.Dock="Left" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />

            <Button x:Name="SaveButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Save" ui:Look.Glyph="&#xE74E;" Click="Save_Click" Margin="6,0,0,0" MinWidth="88" ToolTip="Saves AcrylicConfiguration.ini (Ctrl+S)" />
            <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="Discard changes" Click="Discard_Click" Margin="6,0,0,0" ToolTip="Forgets every change made since the last save and reads the file again" />
            <ToggleButton x:Name="TextModeButton" DockPanel.Dock="Right" Style="{StaticResource ToolToggle}" Content="Edit as text" ui:Look.Glyph="&#xE8A5;" Checked="TextMode_Changed" Unchecked="TextMode_Changed" Margin="6,0,10,0" ToolTip="Shows the whole file, comments included, in a plain text editor. Ctrl + mouse wheel changes the size of its text." />
            <Border x:Name="UnsavedChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource AmberSoftBrush}" Margin="0,0,6,0" Visibility="Collapsed" ToolTip="What you changed is not in the file yet: press Save (Ctrl+S)">
                <TextBlock Text="Not saved yet" Foreground="{DynamicResource AmberBrush}" FontSize="12" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Border x:Name="NoticePanel" Grid.Row="1" Background="{DynamicResource AmberSoftBrush}" BorderBrush="{DynamicResource AmberLineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="16,0,16,10" Visibility="Collapsed">
            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" TextTrimming="None" />
        </Border>

        <!-- Structured editor -->

        <Grid x:Name="StructuredPanel" Grid.Row="2" Margin="16,0,6,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="214" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="CategoryList" Grid.Column="0" Style="{StaticResource NavList}" Margin="0,0,14,0" SelectionChanged="CategoryList_SelectionChanged" AutomationProperties.Name="Categories">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center" Visibility="{Binding HasModified, Converter={StaticResource BoolToVisibility}}" ToolTip="Parameters changed and not saved yet">
                                <TextBlock Text="{Binding ModifiedCount}" Foreground="{DynamicResource OnAccentBrush}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer x:Name="PaneScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,10,0">
                <StackPanel>

                    <TextBlock x:Name="PaneTitle" Style="{StaticResource Heading}" />
                    <TextBlock x:Name="PaneDescription" Style="{StaticResource Subtle}" TextTrimming="None" Margin="0,5,0,12" MaxWidth="820" HorizontalAlignment="Left" />

                    <ItemsControl x:Name="ServerList" ItemTemplate="{StaticResource ServerCardTemplate}" Focusable="False" />

                    <Border x:Name="RowsCard" Style="{StaticResource Card}">
                        <ItemsControl x:Name="RowList" ItemTemplate="{StaticResource SettingRowTemplate}" ItemContainerStyle="{StaticResource RowContainer}" Focusable="False" />
                    </Border>

                    <Border x:Name="AllowedCard" Style="{StaticResource Card}" Padding="16,14">
                        <StackPanel>
                            <TextBlock x:Name="AllowedEmptyText" Style="{StaticResource Subtle}" Text="No address is listed: Acrylic answers only the requests coming from this computer." Margin="0,0,0,10" />
                            <ItemsControl x:Name="AllowedList" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                                            <TextBox Width="300" FontFamily="{StaticResource MonoFont}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ui:Look.Placeholder="192.168.1.*" AutomationProperties.Name="Allowed address" />
                                            <Button Style="{StaticResource GhostButton}" ui:Look.Glyph="&#xE74D;" Margin="6,0,0,0" ToolTip="Remove this address" Click="RemoveAllowed_Click" AutomationProperties.Name="Remove this address" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add an address" ui:Look.Glyph="&#xE710;" HorizontalAlignment="Left" Click="AddAllowed_Click" />
                            <Border x:Name="AllowedWarning" Background="{DynamicResource AmberSoftBrush}" CornerRadius="6" Padding="12,7" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" TextTrimming="None" Text="An entry made of a single * lets Acrylic handle the requests coming from any IP address. This is not recommended for security reasons." />
                            </Border>
                            <TextBlock Style="{StaticResource Subtle}" FontSize="12" TextTrimming="None" Margin="0,14,0,0">
                                <Run Text="Examples:" FontWeight="SemiBold" />
                                <LineBreak />
                                <Run Text="192.168.45.254   " FontFamily="{StaticResource MonoFont}" xml:space="preserve" /><Run Text="a single IP address" />
                                <LineBreak />
                                <Run Text="192.168.100.*    " FontFamily="{StaticResource MonoFont}" xml:space="preserve" /><Run Text="all addresses starting with 192.168.100" />
                                <LineBreak />
                                <Run Text="172.16.*         " FontFamily="{StaticResource MonoFont}" xml:space="preserve" /><Run Text="all addresses starting with 172.16" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="NoResultsText" Style="{StaticResource Subtle}" Text="No parameter matches what you typed." Margin="2,8,0,0" Visibility="Collapsed" />

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Plain text editor -->

        <Border x:Name="TextPanel" Grid.Row="2" Style="{StaticResource Card}" Margin="16,0,16,12" Visibility="Collapsed" ClipToBounds="True">
            <TextBox x:Name="TextEditor" Style="{StaticResource CodeEditor}" TextChanged="TextEditor_TextChanged" AutomationProperties.Name="Configuration file text" />
        </Border>

    </Grid>
</UserControl>
