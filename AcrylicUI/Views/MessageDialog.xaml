<Window x:Class="AcrylicUI.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="380" MaxWidth="620" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="22,20,26,22">
            <TextBlock x:Name="Sign" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="26" VerticalAlignment="Top" Margin="0,1,16,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420" Focusable="False">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextTrimming="None" VerticalAlignment="Center" />
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</Window>
