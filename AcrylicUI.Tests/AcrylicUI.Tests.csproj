<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Self-checking console program for the non visual part of Acrylic DNS Proxy UI (the files under AcrylicUI\Core).
    It has no dependencies: run it with "dotnet run" from this directory, it exits with 0 when every check passes.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AcrylicUI.Tests</AssemblyName>
    <RootNamespace>AcrylicUI.Tests</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\AcrylicUI\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Reference Include="System.ServiceProcess" />
  </ItemGroup>

</Project>
